        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"NoSuchFieldError: SslContext missing defaultEndpointVerificationAlgorithm on startup\",\n    \"description\": \"Application fails to start when making HTTP calls via Azure SDK. The error occurs in Netty QUIC/HTTP3 SSL context initialization. Likely a Netty version conflict between io.netty (core) and io.netty.incubator.codec.quic used by reactor-netty-http\",\n    \"stackTrace\": \"java.lang.NoSuchFieldError: Class io.netty.handler.ssl.SslContext does not have member field 'java.lang.String defaultEndpointVerificationAlgorithm'\\n\\tat  io.netty.handler.codec.quic.QuicheQuicSslContext.<clinit>(QuicheQuicSslContext.java: 73)\\n\\tat io.netty.handler.codec.quic.QuicSslContextBuilder.<init>(QuicSslContextBuilder.java: 183)\\n\\tat    io.netty.handler.codec.quic.QuicSslContextBuilder.forClient(QuicSslContextBuilder.java: 98)\\n\\tat reactor.netty.http.Http3SslContextSpec.forClient(Http3SslContextSpec.java: 57)\\n\\tat      reactor.netty.http.client.HttpClientSecure.<clinit>(HttpClientSecure.java: 82)\\n\\tat reactor.netty.http.client.HttpClientConnect$MonoHttpConnect.lambda$subscribe$0(HttpClientConnect.java: 227)\\n\\tat  reactor.core.publisher.MonoCreate.subscribe(MonoCreate.java: 61)\\n\\tat reactor.core.publisher.InternalMonoOperator.subscribe(InternalMonoOperator.java: 76)\\n\\tat reactor.core.publisher.FluxRetryWhen.subscribe(FluxRetryWhen.java: 81)\\n\\tat  reactor.core.publisher.MonoRetryWhen.subscribeOrReturn(MonoRetryWhen.java: 46)\\n\\tat reactor.core.publisher.InternalMonoOperator.subscribe(InternalMonoOperator.java: 63)\\n\\tat reactor.netty.http.client.HttpClientConnect$MonoHttpConnect.subscribe(HttpClientConnect.java: 301)\\n\\tat reactor.core.publisher.Mono.subscribe(Mono.java: 4576)\\n\\tat reactor.core.publisher.Mono.block(Mono.java: 1778)\\n\\tat com.azure.core.http.netty.NettyAsyncHttpClient.sendSync(NettyAsyncHttpClient.java: 174)\\n\\tat com.azure.core.http.HttpPipelineNextSyncPolicy.processSync(HttpPipelineNextSyncPolicy.java: 51)\\n\\tat com.azure.core.http.policy.HttpLoggingPolicy.processSync(HttpLoggingPolicy.java: 175)\\n\\tat com.azure.core.http.HttpPipelineNextSyncPolicy.processSync(HttpPipelineNextSyncPolicy.java: 53)\\n\\tat com.azure.core.implementation.http.policy.InstrumentationPolicy.processSync(InstrumentationPolicy.java: 101)\",\n    \"source\": \"local\",\n    \"repoPath\": \"/Users/saravananr/git/aava-core-api-embedding-service\",\n    \"destination\": \"lucene\",\n    \"priority\": \"high\"\n}",
          "options": {
